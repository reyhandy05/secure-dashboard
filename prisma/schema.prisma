generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String?
  role             String    @default("USER")
  accessStatus     String    @default("ACTIVE")
  mfaEnabled       Boolean   @default(false)
  loginOtpHash     String?
  loginOtpExpires  DateTime?
  deleteOtpHash    String?
  deleteOtpExpires DateTime?
  roleOtpHash      String?
  roleOtpExpires   DateTime?
  roleOtpTargetId  String?
  roleOtpNewRole   String?
  mfaOtpHash       String?
  mfaOtpExpires    DateTime?
  lastSeenAt       DateTime?
  inviteTokenHash  String?   @unique
  inviteTokenExpires DateTime?
  inviteAcceptedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Incident {
  id         String   @id @default(cuid())
  incidentId String   @unique
  title      String
  asset      String
  owner      String   @default("Ariel Reyhandy")
  severity   String
  status     String   @default("Open")
  time       String   @default("Just now")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
