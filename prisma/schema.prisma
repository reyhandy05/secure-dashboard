generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  role               String    @default("Viewer")
  accessStatus       String    @default("Active")
  mfaEnabled         Boolean   @default(false)

  // Field MFA & Login OTP
  mfaOtpHash         String?
  mfaOtpExpires      DateTime?
  loginOtpHash       String?
  loginOtpExpires    DateTime?

  // Field Role OTP
  roleOtpHash        String?
  roleOtpExpires     DateTime?
  roleOtpTargetId    String?
  roleOtpNewRole     String?

  // Field Delete & Invite
  deleteOtpHash      String?
  deleteOtpExpires   DateTime?
  inviteTokenHash    String?   @unique
  inviteTokenExpires DateTime?
  inviteAcceptedAt   DateTime?

  // Field Realtime Presence
  lastSeenAt         DateTime?

  incidents          Incident[] @relation("IncidentUser")

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Incident {
  id          String   @id @default(cuid())
  incidentId  String?  @unique
  title       String
  asset       String   @default("GLOBAL-GATEWAY")
  owner       String   @default("SOC Lead")
  severity    String   @default("Medium")
  status      String   @default("Open")
  time        String?  @default("Just now")
  description String?
  sourceIp    String?
  assignedTo  String?
  userId      String?
  user        User?    @relation("IncidentUser", fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}