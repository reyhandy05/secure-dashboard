generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // atau "sqlite" / "mysql" sesuai database proyekmu
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  passwordHash       String
  role               String    @default("Viewer")
  accessStatus       String    @default("Active")
  mfaEnabled         Boolean   @default(false)
  
  // Field untuk MFA & Login OTP
  mfaOtpHash         String?
  mfaOtpExpires      DateTime?
  loginOtpHash       String?
  loginOtpExpires    DateTime?
  
  // Field untuk Role OTP & Delete/Invite
  roleOtpHash        String?
  roleOtpExpires     DateTime?
  deleteOtpHash      String?
  deleteOtpExpires   DateTime?
  inviteTokenHash    String?
  inviteTokenExpires DateTime?
  inviteAcceptedAt   DateTime?
  
  // Field untuk Realtime Presence
  lastSeenAt         DateTime?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}